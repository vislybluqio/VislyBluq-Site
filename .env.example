GROQ_API_KEY=
# Optional: override the Groq chat model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=

# Cloudinary for file uploads
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mailchimp newsletter (server-side only: no VITE_ prefix)
# The API key's ending, e.g. -us21, tells the site which Mailchimp data center to use.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Email configuration
VITE_FORMSUBMIT_SALES_EMAIL=sales@vislybluq.com
VITE_FORMSUBMIT_HR_EMAIL=hr@vislybluq.com
VITE_FORMSUBMIT_INFO_EMAIL=info@vislybluq.com
