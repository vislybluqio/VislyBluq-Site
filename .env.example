# AI chatbot: Gemini is primary, OpenRouter free models are the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Cloudinary for file uploads
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mailchimp newsletter (server-side only: no VITE_ prefix)
# The API key's ending, e.g. -us21, tells the site which Mailchimp data center to use.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# FormSubmit recipients (server-side only). Activate each recipient through FormSubmit's verification email.
FORMSUBMIT_CONTACT_EMAIL=hello@vislybluq.com
FORMSUBMIT_APPLICATION_EMAIL=hello@vislybluq.com
