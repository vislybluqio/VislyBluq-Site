{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "redirects": [
    {
      "source": "/projects",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/industries/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/focus/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=()"
        }
      ]
    }
  ]
}
